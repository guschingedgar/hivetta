# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public origin of the deployed web app; the MCP endpoint is $APP_URL/api/mcp
APP_URL=http://localhost:3000

# Optional semantic embeddings. Without this key, keyword-only search works.
OPENAI_API_KEY=sk-...

# Worker only. Session pooler (port 5432) or direct connection — never the
# transaction pooler (6543): pg-boss needs LISTEN/NOTIFY and session state.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Optional local model gateway. Set to 1 only on your own machine.
LOCAL_MODEL_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
